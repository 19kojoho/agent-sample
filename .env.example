# --- AWS / Bedrock ---
# Standard boto3 chain works here. If you have IRSA, an instance profile, or
# valid temp credentials already in your environment, you can leave the four
# AWS_* values blank below and boto3 will resolve them automatically. See
# the IAM follow-up PDF for details on each pattern.
AWS_REGION=us-east-1
# Uncomment and fill these for local dev with assumed credentials:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Bedrock inference profile to use for the agent. Haiku is fastest and cheapest;
# swap to Sonnet 4.6 or Opus 4.x if you want a stronger reasoning model.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- Galileo ---
# Get your API key from https://app.galileo.ai/settings/api-keys
GALILEO_CONSOLE_URL=https://app.galileo.ai
GALILEO_API_KEY=
GALILEO_PROJECT=agent-sample
GALILEO_LOG_STREAM=production

# For the Strands variant only. Same key as above, but the OTel exporter
# needs the API endpoint, not the console URL.
GALILEO_API_ENDPOINT=https://api.galileo.ai/otel/traces
